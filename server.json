{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Omnidim/omnidim-mcp-server",
  "title": "OmniDimension",
  "description": "Build and deploy voice AI agents, make calls, and run call campaigns, workflows and WhatsApp.",
  "status": "active",
  "repository": {
    "url": "https://github.com/Omnidim/omnidim-mcp-server",
    "source": "github"
  },
  "version": "0.24.1",
  "websiteUrl": "https://omnidim.io",
  "icons": [
    {
      "src": "https://omnidim.io/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@omnidim-ai/mcp-server",
      "version": "0.24.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OMNIDIM_API_KEY",
          "description": "OmniDimension API key. Generate one at https://omnidim.io/api-management",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.omnidim.io/mcp"
    }
  ]
}
