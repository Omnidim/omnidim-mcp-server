{
  "name": "@omnidim-ai/mcp-server",
  "version": "0.24.0",
  "mcpName": "io.github.Omnidim/omnidim-mcp-server",
  "description": "Official MCP server for OmniDimension. Build and deploy voice AI agents, make calls, and run call campaigns, workflows and WhatsApp from any MCP client.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "omnidim-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc && shx chmod 755 build/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src scripts tests",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:canvas": "npm run build && node tests/canvas-browser/run.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "regen": "node scripts/regen.mjs && npm run build",
    "check:spec": "node scripts/check-spec.mjs",
    "prestart": "npm run build",
    "preinspect": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "omnidim",
    "omnidimension",
    "voice-ai",
    "voice-agent",
    "claude",
    "cursor",
    "anthropic"
  ],
  "homepage": "https://omnidim.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omnidim/omnidim-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Omnidim/omnidim-mcp-server/issues"
  },
  "author": "OmniDimension <support@omnidim.io>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "axios": "^1.9.0",
    "json-schema-to-zod": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.1.0",
    "js-yaml": "^5.4.1",
    "oxlint": "1.94.0",
    "playwright-core": "1.63.0",
    "shx": "^0.4.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
